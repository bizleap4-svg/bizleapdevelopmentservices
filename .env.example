# Bizleap Development Services - Environment Configuration

# Production Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.bizdevelopment.in

# Recipient Email for Contact Form Inquiries
CONTACT_RECEIVER_EMAIL=bizleapinc@gmail.com

# Gmail SMTP Configuration for automatic email sending:
# 1. Login to the Google account for bizleapinc@gmail.com
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App password named "Bizleap Website"
# 4. Copy the 16-character code and paste below:
GMAIL_USER=bizleapinc@gmail.com
GMAIL_APP_PASSWORD=

# Alternative: Resend API Key (optional)
# RESEND_API_KEY=re_...
